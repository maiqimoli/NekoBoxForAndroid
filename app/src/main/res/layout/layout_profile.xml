<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/cyber_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/cyber_stroke">

    <!-- 1.8: 扁平化为单层 ConstraintLayout，消除多次 measure/layout 调用 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 选中指示条 -->
        <View
            android:id="@+id/selected_view"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_selected_rail"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <!-- 节点名称 -->
        <TextView
            android:id="@+id/profile_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/cyber_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/edit"
            app:layout_constraintStart_toEndOf="@+id/selected_view"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@string/profile_name" />

        <!-- 编辑按钮 -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/edit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/edit"
            android:focusable="true"
            android:nextFocusDown="@+id/share"
            android:padding="10dp"
            android:alpha="0.72"
            app:layout_constraintEnd_toStartOf="@+id/share"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_image_edit"
            app:tint="@color/cyber_text_secondary" />

        <!-- 分享按钮区域 -->
        <LinearLayout
            android:id="@+id/share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more_actions"
            android:focusable="true"
            android:nextFocusLeft="@+id/profile_name"
            app:layout_constraintEnd_toStartOf="@+id/remove"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/share_layer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/shareIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.72"
                    app:srcCompat="@drawable/ic_baseline_more_vert_24"
                    app:tint="@color/cyber_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- 删除按钮 -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/remove"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete"
            android:focusable="true"
            android:padding="10dp"
            android:alpha="0.72"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_action_delete"
            app:tint="@color/cyber_text_secondary" />

        <!-- 地址 + 流量行 -->
        <LinearLayout
            android:id="@+id/address_traffic_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/selected_view"
            app:layout_constraintTop_toBottomOf="@+id/profile_name"
            tools:visibility="visible">

            <TextView
                android:id="@+id/profile_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="@string/server_address"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/traffic_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/traffic"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 协议标签 + 延迟徽章行 -->
        <LinearLayout
            android:id="@+id/badge_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="9dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/selected_view"
            app:layout_constraintTop_toBottomOf="@+id/address_traffic_row">

            <TextView
                android:id="@+id/profile_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_protocol_badge"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/cyber_cyan_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="VLESS" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/favorite_indicator"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_star_filled_24"
                app:tint="@color/cyber_amber_text" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/profile_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_latency_badge"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:singleLine="true"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="12sp"
                tools:text="128 ms" />
        </LinearLayout>

        <!-- 链式代理详情（可展开） -->
        <LinearLayout
            android:id="@+id/chain_details_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/selected_view"
            app:layout_constraintTop_toBottomOf="@+id/badge_row"
            tools:visibility="visible">

            <TextView
                android:id="@+id/chain_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/cyber_text_secondary"
                tools:text="1. Japan 203.0.113.1 120ms&#10;2. Landing 198.51.100.1 timeout" />
        </LinearLayout>

        <!-- 底部约束锚点（让卡片高度自适应最后一个可见行） -->
        <View
            android:id="@+id/bottom_anchor"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chain_details_container" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
