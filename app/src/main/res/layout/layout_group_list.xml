<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_background"
    android:orientation="vertical"
    tools:context=".ui.ConfigurationFragment">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/group_tab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="@dimen/group_tab_outer_top_margin"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="@dimen/group_tab_outer_bottom_margin"
        android:background="@drawable/bg_segmented_container"
        android:elevation="0dp"
        android:minHeight="@dimen/group_tab_min_height"
        android:visibility="gone"
        app:tabIndicatorColor="@android:color/transparent"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorHeight="0dp"
        app:tabMode="scrollable"
        app:tabPaddingStart="4dp"
        app:tabPaddingEnd="4dp"
        app:tabRippleColor="@color/cyber_stroke_soft"
        app:tabSelectedTextColor="@color/cyber_text_primary"
        app:tabTextColor="@color/cyber_text_secondary"
        app:tabUnboundedRipple="false" />

    <HorizontalScrollView
        android:id="@+id/profile_filter_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cyber_background"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingStart="8dp"
        android:paddingTop="1dp"
        android:paddingEnd="8dp"
        android:paddingBottom="@dimen/profile_filter_bottom_padding"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/profile_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="3dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_all"
                style="@style/Widget.SagerNet.CyberFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_recent"
                style="@style/Widget.SagerNet.CyberFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_recent" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_hk"
                style="@style/Widget.SagerNet.CyberFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_hk" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_us"
                style="@style/Widget.SagerNet.CyberFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_us" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_jp"
                style="@style/Widget.SagerNet.CyberFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_jp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_fast"
                style="@style/Widget.SagerNet.CyberFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_fast" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_favorites"
                style="@style/Widget.SagerNet.CyberFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_favorites" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/group_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
