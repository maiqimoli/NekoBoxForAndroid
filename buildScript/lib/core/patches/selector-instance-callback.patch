+func (s *Selector) SetSelectCallback(callback func(selectorTag string, tag string)) {
+	s.callbackAccess.Lock()
+	s.selectCallback = callback
+	s.callbackAccess.Unlock()
+}
+
+func (s *Selector) notifySelected(tag string) {
+	s.callbackAccess.RLock()
+	callback := s.selectCallback
+	s.callbackAccess.RUnlock()
+	if callback != nil {
+		callback(s.Tag(), tag)
+		return
+	}
+	if nekoutils.Selector_OnProxySelected != nil {
+		nekoutils.Selector_OnProxySelected(s.Tag(), tag)
+	}
+}
